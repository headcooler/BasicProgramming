#####################################################################
# Unreal Engine (UE 5.x / UE 5.7.4) - C++ Project
#####################################################################

# --- Unreal build products ---
Binaries/
DerivedDataCache/
Intermediate/
Saved/

# UBT/Packaging artifacts
*.target
*.modules
*.version
*.receipt
*.manifest
*.pdb
*.exp
*.ilk
*.obj
*.idb
*.pch
*.ipch
*.iobj
*.ipdb
*.dSYM/

# Logs / crash dumps
*.log
*.dmp

# UAsset/UMap are SOURCE ASSETS -> do NOT ignore
# *.uasset
# *.umap

#####################################################################
# Unreal-generated project files (keep source, ignore generated)
#####################################################################

# Visual Studio / MSBuild generated solution/project files (usually regenerated)
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.VC.db
*.VC.opendb
*.suo

# Unreal .vs workspace
.vs/

# Unreal generated Xcode files (if ever used)
*.xcodeproj/
*.xcworkspace/

#####################################################################
# JetBrains Rider / IntelliJ
#####################################################################

# Rider / IntelliJ project metadata
.idea/
Debug/
*.sln.iml
*.ipr
*.iws

# Rider caches (some variants)
**/.Rider*/
**/riderModule.iml

#####################################################################
# Unreal + Rider (generated project model files)
#####################################################################

# Rider for Unreal can generate these; safe to ignore
# (If your team intentionally shares Rider configs, remove the patterns)
Plugins/Developer/RiderLink/Intermediate/
Plugins/Developer/RiderLink/Binaries/

#####################################################################
# C++ / Build system leftovers
#####################################################################

# CMake (some teams generate CMake for tooling)
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
compile_commands.json

# clang tooling
*.clangd
.cache/

#####################################################################
# OS-specific
#####################################################################

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store

# Linux
*~

#####################################################################
# Optional: ignore packaged builds (uncomment if you store packages elsewhere)
#####################################################################
# Packaged/
# StagedBuilds/